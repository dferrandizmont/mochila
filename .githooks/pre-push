#!/bin/sh
# Checks every commit about to be pushed (also those made with --no-verify).
script="$(git rev-parse --show-toplevel)/.githooks/check-identity.sh"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha" 2>/dev/null \
    && git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    sh "$script" range "$remote_sha..$local_sha" || status=1
  else
    # New branch or rewritten history: everything not already on the remote.
    sh "$script" range "$local_sha" --not --remotes="$1" || status=1
  fi
done
exit $status
